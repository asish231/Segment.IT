# --- LLM refinement (Mercury-2.5 via Inception Labs) ---
# Local (non-docker) runs read INCEPTION_LABS_MERCURY_2.5 (llm_refiner.py). Docker
# Compose can't interpolate an env var name with a dot, so it reads MERCURY_API_KEY
# instead — set both to the same value, or just MERCURY_API_KEY for docker.
INCEPTION_LABS_MERCURY_2.5=
MERCURY_API_KEY=

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-64-char-secret
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

# First-boot admin bootstrap (optional; only runs if the users table is empty)
ADMIN_EMAIL=admin@bhoomi.local
ADMIN_PASSWORD=change-me

# --- Storage ---
# Local dev default: sqlite:///./data/app.db
# Docker/production: postgresql+psycopg2://bhoomi:bhoomi@postgres:5432/bhoomi
DATABASE_URL=sqlite:///./data/app.db
JOBS_DIR=data/jobs

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (Vite) ---
VITE_API_BASE_URL=

# --- docker-compose only ---
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=bhoomi
MINIO_ROOT_PASSWORD=change-me-min-8-chars
